      vec4 a=PocketTex(transform),b=PocketTex(transform+1),c=PocketTex(transform+2),e=PocketTex(transform+3);
      localP=vec4(dot(a,p),dot(b,p),dot(c,p),dot(e,p));
      localD=vec4(dot(a,d),dot(b,d),dot(c,d),dot(e,d));
    }
    float endT=maximum;int exitPlane=-1;bool valid=true;
     for(int j=0;j<5;++j) {
      vec4 n;float h;PocketStaticSector(j,n,h);float den=dot(n,localD);
      float num=h-dot(n,localP);
      if(num-cursor*den< -2e-7)valid=false;
      if(den>1e-10) {
        float crossing=num/den;
        if(crossing<endT){endT=crossing;exitPlane=j;}
      }
    }
     if(!valid) {
      if(!worldReady){PocketRestoreEntry(initialCode,p,back);d=-back-sine*p;worldReady=true;}
      int corrected=PocketLocate(p+cursor*d,code,facetCount,copies,facetOffset,stride);
      if(corrected<0)return false;
      if(corrected!=code){code=corrected;continue;}
    }
    if(endT>cursor){
      if(PocketSolidSegment(localP,localD,cursor,endT,epsilon,nodeOffset,count))return true;
    }
    if(exitPlane<0)return false;
    int route=routeOffset+(cell*copies+corner)*routeStride+(exitPlane>>2);
    code=int(round(PocketTex(route)[exitPlane&3]));
    if(code<0)return false;
    cursor=max(endT+epsilon,cursor+epsilon);
  }
  // A guard against corrupted data or a numerically stalled traversal. Valid
  // generated atlases are checked separately for termination.
  return cursor<maximum;
}
bool HullPocketOccludedPrepared(vec4 p,vec4 back,float sine,int code,vec4 preparedP,vec4 preparedBack,bool prepared,bool canonicalOnly) {
  return HullPocketOccludedPreparedTarget(p,back,sine,code,preparedP,preparedBack,prepared,canonicalOnly,-1);
}
bool HullPocketOccludedEntry(vec4 p,vec4 back,float sine,int code) {
  return HullPocketOccludedPrepared(p,back,sine,code,vec4(0),vec4(0),false,false);
}
bool HullPocketOccludedCanonical(vec4 p,vec4 back,float sine,int code) {
  return HullPocketOccludedPrepared(p,back,sine,code,p,back,code>=0,code>=0);
}
// GPU probes use source unit IDs. Render meshes carry the same entry directly
// in their spare POSITION.z word; no per-pixel unit lookup is needed.
bool HullPocketOccluded(vec4 p,vec4 back,float sine,int globalUnit) {
  int seedOffset=int(round(uPocketHeader0.w));
  int code=int(round(PocketTex(seedOffset+(globalUnit>>2))[globalUnit&3]));
  return HullPocketOccludedEntry(p,back,sine,code);
}
