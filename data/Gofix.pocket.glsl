 vec4 q=vec4(dot(vec4(-0.8090169944,-0.5,-0.3090169944,0),p),dot(vec4(-0.8090169944,-0.3090169944,1.347283942e-16,-0.5),p),dot(vec4(-0.8090169944,-0.5,0.3090169944,-0),p),dot(vec4(-1,1.496982157e-18,1.347283942e-16,0),p));
 vec4 v=vec4(dot(vec4(-0.8090169944,-0.5,-0.3090169944,0),d),dot(vec4(-0.8090169944,-0.3090169944,1.347283942e-16,-0.5),d),dot(vec4(-0.8090169944,-0.5,0.3090169944,-0),d),dot(vec4(-1,1.496982157e-18,1.347283942e-16,0),d));
 float crosses[6];int index=0;
 for(int i=0;i<4;i++)for(int j=i+1;j<4;j++){float den=v[i]-v[j];crosses[index++]=abs(den)>1e-10?(q[j]-q[i])/den:1e20;}
