bool PocketSolidSegment(vec4 p,vec4 d,float beginT,float endT,float epsilon,int nodeOffset,int count) {
  if(endT-beginT<=epsilon)return false;
  vec4 root=PocketTex(nodeOffset);
  uint rootChildren=PocketChildren(root);
  // All supported operation trees have one empty root and depth <= 2.
  if(endT-beginT<2.0*epsilon) {
    vec2 interval=PocketStaticRootInterval(p,d,endT);
    if(interval.x>beginT+epsilon || interval.y<endT-epsilon)return true;
  } else {
    if(PocketFoldOutside(p+(beginT+epsilon)*d,p+(endT-epsilon)*d))return true;
  }
  return ReducedPocketFoldSpikes(p,d,beginT,endT,epsilon);
}
// Called only when the cached entry crosses an edge or the patch spans sectors.
// This correction locates a sector in the same complete pocket representation.
int PocketLocate(vec4 q,int code,int facetCount,int copies,int facetOffset,int stride) {
  int cell=code>>5;
   for(int search=0;search<facetCount;++search) {
    int row=facetOffset+cell*stride,best=cell;float value=dot(PocketTex(row),q);vec4 meta=PocketTex(row+1);
     for(int j=0;j<int(round(meta.x));++j) {
      int candidate=int(round(PocketTex(row+2+(j>>2))[j&3]));float test=dot(PocketTex(facetOffset+candidate*stride),q);
      if(test>value+1e-8){value=test;best=candidate;}
    }
    if(best==cell)break;cell=best;
  }
  int row=facetOffset+cell*stride;
  if(dot(PocketTex(row),q)>1.0+1e-7)return -1;
  int corner=0;
  if(copies>1) {
    int vertexOffset=int(round(PocketTex(row+1).z));float best=-1e20;
     for(int j=0;j<copies;++j) {float value=dot(PocketTex(vertexOffset+j),q);if(value>best){best=value;corner=j;}}
  }
  return (cell<<5)|corner;
}
int PocketInitialSector(vec4 q,int code,int copies,int facetOffset,int stride) {
    if(code>=0)return code;
    // The actual .88 drawing patch spans only two or five hull cells. Its
    // precomputed candidate list replaces a hill climb at the first pixel.
    int entry=-code-1,entryCell=0;float entryBest=-1e20;
    int entryCount=int(round(PocketTex(entry).x));
     for(int j=0;j<entryCount;++j) {
      int candidate=int(round(PocketTex(entry+1+(j>>2))[j&3]));
      float value=dot(PocketTex(facetOffset+candidate*stride),q);
      if(value>entryBest){entryBest=value;entryCell=candidate;}
    }
    if(entryBest>1.0+1e-7)return -1;
    int entryCorner=0;
    if(copies>1) {
      int vertices=int(round(PocketTex(facetOffset+entryCell*stride+1).z));entryBest=-1e20;
       for(int j=0;j<copies;++j) {float value=dot(PocketTex(vertices+j),q);if(value>entryBest){entryBest=value;entryCorner=j;}}
    }
    return (entryCell<<5)|entryCorner;

}
void PocketPrepareEntry(vec4 p,vec4 back,int code,out vec4 localP,out vec4 localBack) {
  localP=p;localBack=back;if(code<0)return;
  int row=int(round(uPocketHeader1.x))+(code>>5)*int(round(uPocketHeader1.y));
  int transform=int(round(PocketTex(row+1).y))+(code&31)*4;
  vec4 a=PocketTex(transform),b=PocketTex(transform+1),c=PocketTex(transform+2),e=PocketTex(transform+3);
  localP=vec4(dot(a,p),dot(b,p),dot(c,p),dot(e,p));
  localBack=vec4(dot(a,back),dot(b,back),dot(c,back),dot(e,back));
}
void PocketRestoreEntry(int code,inout vec4 p,inout vec4 back) {
  int row=int(round(uPocketHeader1.x))+(code>>5)*int(round(uPocketHeader1.y));
  int transform=int(round(PocketTex(row+1).y))+(code&31)*4;
  vec4 a=PocketTex(transform),b=PocketTex(transform+1),c=PocketTex(transform+2),e=PocketTex(transform+3);
  p=a*p.x+b*p.y+c*p.z+e*p.w;
  back=a*back.x+b*back.y+c*back.z+e*back.w;
}
bool HullPocketOccludedPreparedTarget(vec4 p,vec4 back,float sine,int code,vec4 preparedP,vec4 preparedBack,bool prepared,bool canonicalOnly,int targetCell) {
  vec4 header=uPocketHeader0,pocketLayout=uPocketHeader1,info=uPocketHeader2,routing=uPocketHeader3;
  int facetCount=int(round(header.x)),copies=int(round(header.y)),count=int(round(header.z));
  int seedOffset=int(round(header.w)),facetOffset=int(round(pocketLayout.x)),stride=int(round(pocketLayout.y));
  int sectorOffset=int(round(pocketLayout.z)),sectorCount=int(round(pocketLayout.w)),nodeOffset=int(round(info.x));
  int routeOffset=int(round(routing.x)),routeStride=int(round(routing.y));
  vec4 d=-back-sine*p;
  int initialCode=code;bool worldReady=!canonicalOnly;
  float epsilon=info.w/max(length(d),1e-9),cursor=epsilon,maximum=sine> 0.0?1.0/sine:1e20;
  code=PocketInitialSector(p+cursor*d,code,copies,facetOffset,stride);
  if(code<0)return false;
   for(int step=0;step<256 && cursor<maximum;++step) {
    int cell=code>>5,corner=code&31;
    vec4 localP,localD;
     if(prepared && step==0) {localP=preparedP;localD=-preparedBack-sine*preparedP;}
    else {
      if(!worldReady){PocketRestoreEntry(initialCode,p,back);d=-back-sine*p;worldReady=true;}
      int row=facetOffset+cell*stride,transform=int(round(PocketTex(row+1).y))+corner*4;
      vec4 a=PocketTex(transform),b=PocketTex(transform+1),c=PocketTex(transform+2),e=PocketTex(transform+3);
      localP=vec4(dot(a,p),dot(b,p),dot(c,p),dot(e,p));
      localD=vec4(dot(a,d),dot(b,d),dot(c,d),dot(e,d));
    }
    float endT=maximum;int exitPlane=-1;bool valid=true;
     for(int j=0;j<5;++j) {
      vec4 n;float h;PocketStaticSector(j,n,h);float den=dot(n,localD);
      float num=h-dot(n,localP);
      if(num-cursor*den< -2e-7)valid=false;
      if(den>1e-10) {
        float crossing=num/den;
        if(crossing<endT){endT=crossing;exitPlane=j;}
      }
    }
     if(!valid) {
      if(!worldReady){PocketRestoreEntry(initialCode,p,back);d=-back-sine*p;worldReady=true;}
      int corrected=PocketLocate(p+cursor*d,code,facetCount,copies,facetOffset,stride);
      if(corrected<0)return false;
      if(corrected!=code){code=corrected;continue;}
    }
    if(endT>cursor){
      if(PocketSolidSegment(localP,localD,cursor,endT,epsilon,nodeOffset,count))return true;
    }
    if(exitPlane<0)return false;
    int route=routeOffset+(cell*copies+corner)*routeStride+(exitPlane>>2);
    code=int(round(PocketTex(route)[exitPlane&3]));
    if(code<0)return false;
    cursor=max(endT+epsilon,cursor+epsilon);
  }
  // A guard against corrupted data or a numerically stalled traversal. Valid
  // generated atlases are checked separately for termination.
  return cursor<maximum;
}
bool HullPocketOccludedPrepared(vec4 p,vec4 back,float sine,int code,vec4 preparedP,vec4 preparedBack,bool prepared,bool canonicalOnly) {
  return HullPocketOccludedPreparedTarget(p,back,sine,code,preparedP,preparedBack,prepared,canonicalOnly,-1);
}
bool HullPocketOccludedEntry(vec4 p,vec4 back,float sine,int code) {
  return HullPocketOccludedPrepared(p,back,sine,code,vec4(0),vec4(0),false,false);
}
bool HullPocketOccludedCanonical(vec4 p,vec4 back,float sine,int code) {
  return HullPocketOccludedPrepared(p,back,sine,code,p,back,code>=0,code>=0);
}
// GPU probes use source unit IDs. Render meshes carry the same entry directly
// in their spare POSITION.z word; no per-pixel unit lookup is needed.
bool HullPocketOccluded(vec4 p,vec4 back,float sine,int globalUnit) {
  int seedOffset=int(round(uPocketHeader0.w));
  int code=int(round(PocketTex(seedOffset+(globalUnit>>2))[globalUnit&3]));
  return HullPocketOccludedEntry(p,back,sine,code);
}
