 if(abs(den)<parallel){if(num< -2e-6)return false;}
 else if(den< 0.0)lo=max(lo,num/den);else hi=min(hi,num/den);return lo<=hi;
}
void ReducedPocketSwap(inout float a,inout float b,inout float p,inout float q,inout float d,inout float e){
 if(a>b){float t=a;a=b;b=t;t=p;p=q;q=t;t=d;d=e;e=t;}
}
