 ReducedPocketSwap(m.x,m.z,a.x,a.z,b.x,b.z);
 ReducedPocketSwap(m.y,m.w,a.y,a.w,b.y,b.w);
 ReducedPocketSwap(m.y,m.z,a.y,a.z,b.y,b.z);
 {float lo=cursor,hi=limit;bool valid=true;
